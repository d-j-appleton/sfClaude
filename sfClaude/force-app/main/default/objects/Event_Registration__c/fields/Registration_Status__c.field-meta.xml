<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Registration_Status__c</fullName>
    <label>Registration Status</label>
    <type>Picklist</type>
    <required>true</required>
    <trackHistory>true</trackHistory>
    <description>The current status of this registration in the attendee lifecycle. Drives roll-up summaries on Event__c (Registered_Count__c counts non-Cancelled; Actual_Attendees__c counts Attended only). History tracked for audit and reporting.</description>
    <inlineHelpText>Select the current registration status. Registered = confirmed booking; Waitlisted = pending availability; Cancelled = booking withdrawn; Attended = checked in on the day; No Show = did not attend without cancelling.</inlineHelpText>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Registered</fullName>
                <default>true</default>
                <label>Registered</label>
            </value>
            <value>
                <fullName>Waitlisted</fullName>
                <default>false</default>
                <label>Waitlisted</label>
            </value>
            <value>
                <fullName>Cancelled</fullName>
                <default>false</default>
                <label>Cancelled</label>
            </value>
            <value>
                <fullName>Attended</fullName>
                <default>false</default>
                <label>Attended</label>
            </value>
            <value>
                <fullName>No Show</fullName>
                <default>false</default>
                <label>No Show</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
