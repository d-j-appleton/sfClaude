<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Event Ticket Type</label>
    <pluralLabel>Event Ticket Types</pluralLabel>
    <nameField>
        <label>Ticket Type Name</label>
        <type>Text</type>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Defines a ticket category for a specific Event__c record. Allows each event to have its own pricing tiers and capacity limits per category (e.g. Standard, VIP, Volunteer). Sharing is Controlled by Parent via Master-Detail to Event__c.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <sharingModel>ControlledByParent</sharingModel>
</CustomObject>
